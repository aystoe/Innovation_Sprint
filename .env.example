# Copy to .env.local. These two values are public browser configuration, not server secrets.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_KEY

# Default: production. Demo fixtures stay out of the live member directory in both modes.
VITE_DATA_MODE=production
